@using System.Linq
@model IEnumerable<HumanResouresMangementSystem.Core.Entites.User>

@{
    ViewData["Title"] = "Users";
}

<div class="container my-4">

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">Admins</h2>
        <a asp-controller="Users"
           asp-action="Create"
           class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Add Admin
        </a>
    </div>

    <!-- Users Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0 text-center">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" style="width: 80px;">Id</th>
                            <th scope="col">Full Name</th>
                            <th scope="col">User Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Group</th>
                            <th scope="col" style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">@user.Id</td>
                                    <td>@user.FullName</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@user.UserName</span>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill">
                                            @user.Group?.Name
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-controller="Users"
                                               asp-action="Edit"
                                               asp-route-id="@user.Id"
                                               class="btn btn-warning btn-sm">
                                                Edit
                                            </a>

                                            <form asp-controller="Users"
                                                  asp-action="Delete"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-danger btn-sm"
                                                        onclick="return confirm('Are you sure you want to delete this user?');">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No users found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>