@model HumanResouresMangementSystem.Core.ViewModels.SalaryReportItemViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>

    <meta charset="utf-8" />
    <title>قسيمة راتب - @Model.EmployeeName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 30px;
        }

        .invoice-card {
            border: 2px solid #000;
            padding: 25px;
            border-radius: 8px;
        }

        <style >
        @@media print {
            .no-print

        {
            display: none;
        }

        }
    </style>
    
</head>
<body>

    <div class="container invoice-card">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h3>إشعار مفردات مرتب</h3>
                <h5>الشهر / السنة: @ViewBag.Month / @ViewBag.Year</h5>
            </div>
            <button onclick="window.print()" class="btn btn-primary no-print">طباعة المستند</button>
        </div>

        <div class="row mb-4">
            <div class="col-6">
                <p><strong>اسم الموظف:</strong> @Model.EmployeeName</p>
            </div>
            <div class="col-6">
                <p><strong>القسم:</strong> @Model.DepartmentName</p>
            </div>
        </div>

        <table class="table table-bordered text-center">
            <thead class="table-dark">
                <tr>
                    <th>البيان</th>
                    <th>العدد / الساعات</th>
                    <th>المبلغ (جنيه)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>الراتب الأساسي</td>
                    <td>-</td>
                    <td>@Model.BasicSalary</td>
                </tr>
                <tr>
                    <td>أيام الحضور / الغياب</td>
                    <td>حضور: @Model.AttendanceDays | غياب: @Model.AbsenceDays</td>
                    <td>-</td>
                </tr>
                <tr class="table-success">
                    <td>الساعات الإضافية</td>
                    <td>@Model.OvertimeHours ساعة</td>
                    <td>+ @Model.TotalOvertime</td>
                </tr>
                <tr class="table-danger">
                    <td>الخصومات والغياب</td>
                    <td>@Model.DeductionHours ساعة</td>
                    <td>- @Model.TotalDeduction</td>
                </tr>
                <tr class="table-info fw-bold">
                    <td colspan="2">صافي الراتب المستحق للصرف</td>
                    <td>@Model.NetSalary</td>
                </tr>
            </tbody>
        </table>

        <div class="row mt-5 pt-4 text-center">
            <div class="col-6">توقيع الموظف: ........................</div>
            <div class="col-6">اعتماد الحسابات: ........................</div>
        </div>
    </div>

    <script>
        // فتح حوار الطباعة مباشرة عند فتح الصفحة
        window.onload = function () {
            window.print();
        }
    </script>
</body>
</html>